{
  "services": {
    "nointerest": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "vite build",
      "outputDirectory": "dist/public"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "nointerest"
      }
    }
  ]
}
